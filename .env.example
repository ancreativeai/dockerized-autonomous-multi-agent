# ── Secrets ─────────────────────────────────────────────────────────────
# Rename this file to .env and fill in your keys (never commit .env).
ANTHROPIC_API_KEY=
# OpenRouter key: enables the free-model chain (and paid models you opt into)
OPENROUTER_API_KEY=

# ── LLM routing (locked at bootstrap: Claude=planner, Hermes=workers) ───
CLAUDE_MODEL=claude-opus-4-8
WORKER_AGENT_COUNT=2

# ── Guardrails ──────────────────────────────────────────────────────────
MONTHLY_TOKEN_CAP=1000000
TOKEN_ALERT_THRESHOLD=80
AUDIT_LOG_RETENTION_DAYS=30
MAX_CONTEXT_TOKENS=16384

# ── GraphRAG vault indexer ──────────────────────────────────────────────
GRAPHRAG_REINDEX_SECONDS=300
GRAPHRAG_MEMORY_LIMIT_MB=1024
GRAPHRAG_TOP_K=6

# ── Autonomous background loop ──────────────────────────────────────────
# Interval for self-generated maintenance tasks when the inbox is empty.
AUTONOMOUS_INTERVAL_SECONDS=1800
# Autonomous self-tasks use Hermes only (true) to avoid burning Claude tokens
# while idle; explicit tasks dropped in workspaces/inbox/ still use Claude.
AUTONOMOUS_HERMES_ONLY=true

# ── Hermes local LLM ────────────────────────────────────────────────────
HERMES_CTX=8192
HERMES_PARALLEL=2
# Force a specific GGUF file instead of RAM auto-detection (optional):
# HERMES_FORCE_FILE=Hermes-3-Llama-3.1-8B.Q4_K_M.gguf

# ── OpenClaw gateway auth (required for container bind; generate: openssl rand -hex 24) ──
OPENCLAW_GATEWAY_TOKEN=
